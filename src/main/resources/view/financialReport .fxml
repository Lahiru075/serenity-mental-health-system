<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="887.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gdse.controller.FinancialReportController">

    <children>
        <!-- Header -->
        <Label layoutX="33.0" layoutY="30.0" text="Financial Report" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Main Content Panel -->
        <AnchorPane layoutX="31.2" layoutY="78.0" prefHeight="557.0" prefWidth="825.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="77.0">
            <children>
                <!-- Date Selection -->
                <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="25.0" spacing="20.0">
                    <children>
                        <Label text="From Date:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <DatePicker fx:id="dpFromDate" prefHeight="30.0" prefWidth="170.0" promptText="Select Start Date" />

                        <Label text="To Date:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <DatePicker fx:id="dpToDate" prefHeight="30.0" prefWidth="170.0" promptText="Select End Date" />

                        <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#btnSearchOnAction" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #3498db; -fx-background-radius: 5;" text="Search" textFill="WHITE">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button fx:id="btnClear" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-background-radius: 5;" text="Clear" textFill="WHITE">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <!-- Description Panel -->
                <VBox layoutX="30.0" layoutY="76.0" prefWidth="765.0">
                    <children>
                        <Label text="Report Description:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Label>
                        <Label fx:id="lblDescription" prefWidth="765.0" text="This report shows financial information between the selected dates including total income, received payments, and pending payments." textFill="#555555" wrapText="true">
                            <font>
                                <Font size="14.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="20.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <!-- Financial Summary Cards -->
                <GridPane hgap="20.0" layoutX="30.0" layoutY="179.0" prefHeight="82.0" prefWidth="766.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <!-- Total Income Card -->
                        <AnchorPane prefHeight="60.0" prefWidth="242.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 5);">
                            <children>
                                <Label layoutX="20.0" layoutY="15.0" text="Total Income" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblTotalIncome" alignment="CENTER_RIGHT" layoutX="22.400000000000006" layoutY="40.0" prefHeight="40.0" prefWidth="200.0" text="0.00" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>

                        <!-- Received Money Card -->
                        <AnchorPane prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #27ae60; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 5);" GridPane.columnIndex="1">
                            <children>
                                <Label layoutX="20.0" layoutY="15.0" text="Received Payments" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblReceivedPayments" alignment="CENTER_RIGHT" layoutX="22.400000000000006" layoutY="41.0" prefHeight="40.0" prefWidth="200.0" text="0.00" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>

                        <!-- Pending Money Card -->
                        <AnchorPane prefHeight="17.0" prefWidth="242.0" style="-fx-background-color: #e74c3c; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 5);" GridPane.columnIndex="2">
                            <children>
                                <Label layoutX="20.0" layoutY="15.0" text="Pending Payments" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblPendingPayments" alignment="CENTER_RIGHT" layoutX="22.400000000000006" layoutY="42.0" prefHeight="40.0" prefWidth="200.0" text="0.00" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </children>
                </GridPane>

                <TableView fx:id="tblPayments" layoutX="30.0" layoutY="320.0" prefHeight="174.0" prefWidth="766.0">
                    <columns>
                        <TableColumn fx:id="colPaymentId" prefWidth="85.60000038146973" text="Payment ID" />
                        <TableColumn fx:id="colAmount" prefWidth="119.20000457763672" text="Amount" />
                        <TableColumn fx:id="colPatientId" prefWidth="96.0" text="Patient ID" />
                        <TableColumn fx:id="colProgramId" prefWidth="89.5999755859375" text="Program ID" />
                        <TableColumn fx:id="colSessionId" prefWidth="109.59994506835938" text="Session ID" />
                        <TableColumn fx:id="colStatus" prefWidth="135.199951171875" text="Status" />
                        <TableColumn fx:id="colDate" prefWidth="137.60009765625" text="Date" />
                    </columns>
                </TableView>

                <!-- Action Buttons -->
                <HBox alignment="CENTER_RIGHT" layoutX="30.0" layoutY="512.0" prefWidth="766.0">
                    <children>
                        <Button fx:id="btnViewPatientHistory" mnemonicParsing="false" onAction="#btnViewPatientHistoryOnAction" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: #9b59b6; -fx-background-radius: 5;" text="View Patient History" textFill="WHITE">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
                  <Label layoutX="30.0" layoutY="281.0" prefHeight="26.0" prefWidth="158.0" text="Payment Details:" textFill="#2c3e50">
                      <font>
                          <Font name="System Bold" size="16.0" />
                      </font>
                  </Label>
            </children>
         <padding>
            <Insets bottom="10.0" />
         </padding>
        </AnchorPane>
    </children>
</AnchorPane>
