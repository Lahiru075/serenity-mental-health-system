<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="497.0" prefWidth="848.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gdse.controller.ViewPatientHistoryController">
    <children>
        <!-- Header -->
        <Label layoutX="33.0" layoutY="30.0" text="Patient History" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Main Content Panel -->
        <AnchorPane layoutX="31.2" layoutY="78.0" prefHeight="490.0" prefWidth="740.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="77.0">
            <children>
                <!-- Patient Selection Area -->
                <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="30.0" spacing="45.0">
                    <children>
                        <Label prefWidth="70.0" text="Patient ID:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbPatientId" onAction="#cmbPatientIdOnAction" prefHeight="30.0" prefWidth="179.0" />

                        <Label text="Patient Name:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblPatientName" prefWidth="200.0" style="-fx-background-color: #f8f9fa; -fx-padding: 5; -fx-background-radius: 3;">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <TableView fx:id="tblPatientHistory" layoutX="30.0" layoutY="143.0" prefHeight="242.0" prefWidth="680.0">
                    <columns>
                        <TableColumn fx:id="colProgramId" prefWidth="100.0" text="Program ID" />
                        <TableColumn fx:id="colProgramName" prefWidth="150.0" text="Program Name" />
                        <TableColumn fx:id="colSessionId" prefWidth="100.0" text="Session ID" />
                        <TableColumn fx:id="colTime" prefWidth="100.79998779296875" text="Time" />
                        <TableColumn fx:id="colDate" prefWidth="118.39999389648438" text="Date" />
                        <TableColumn fx:id="colStatus" prefWidth="110.4000244140625" text="Status" />
                    </columns>
                </TableView>

                  <Button fx:id="btnSearch" layoutX="30.0" layoutY="88.0" mnemonicParsing="false" onAction="#btnSearchOnAction" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 5;" text="Search" textFill="WHITE">
                      <font>
                          <Font size="14.0" />
                      </font>
                  </Button>
            <Button fx:id="btnClear" layoutX="156.0" layoutY="89.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="26.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-background-radius: 5;" text="Clear" textFill="WHITE">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
        </AnchorPane>
    </children>
</AnchorPane>
