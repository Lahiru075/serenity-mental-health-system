<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainAnchorPane" prefHeight="700.0" prefWidth="1116.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gdse.controller.ReceptionistDashBoardController">
    <children>
        <!-- Side Navigation Panel -->
        <VBox prefHeight="712.0" prefWidth="264.0" style="-fx-background-color: #2c3e50;">
            <children>
                <!-- Dashboard Header -->
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="250.0">
                    <children>
                        <Label text="Receptionist Dashboard" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Navigation Buttons -->
                <Button fx:id="btnCredentialManage" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#btnCredentialManageOnAction" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" text="Credential Management" textFill="WHITE">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                </Button>

                <Button fx:id="btnPatientManage" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#btnPatientManageOnAction" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" text="Patient Management" textFill="WHITE">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                </Button>

                <Button fx:id="btnTherapySessionScheduling" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#btnTherapySessionSchedulingOnAction" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" text="Therapy Session Scheduling" textFill="WHITE" wrapText="true">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                </Button>

                <Button fx:id="btnPaymentInvoiceManage" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#btnPaymentInvoiceManageOnAction" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" text="Payment and Invoice Management" textFill="WHITE" wrapText="true">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                </Button>

                <Button fx:id="btnReportingAnalytics" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#btnReportingAnalyticsOnAction" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" text="Reporting and Analytics" textFill="WHITE" wrapText="true">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                </Button>

                <Pane prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />

                <Button fx:id="btnLogout" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#btnLogoutOnAction" prefHeight="60.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" text="Log Out" textFill="WHITE">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                </Button>
            </children>
        </VBox>

        <!-- Main Content Area -->
        <AnchorPane fx:id="subAnchorPaneOne" layoutX="267.0" layoutY="61.0" prefHeight="650.0" prefWidth="887.0" style="-fx-background-color: #f5f5f5;">
            <children>

                <!-- Dashboard Title -->
                <Label fx:id="lblDashboardTitle" layoutX="30.0" layoutY="80.0" text="Receptionist Overview">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <!-- Dashboard Stats -->
                <HBox layoutX="35.0" layoutY="196.0" prefHeight="100.0" prefWidth="822.0" spacing="80.0">
                    <children>
                        <AnchorPane prefHeight="100.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);">
                            <children>
                                <Label layoutX="57.0" layoutY="14.0" text="Total Patients">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblTotalPatients" layoutX="94.0" layoutY="50.0" text="78">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>

                        <AnchorPane prefHeight="100.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);">
                            <children>
                                <Label layoutX="37.0" layoutY="14.0" text="Today's Appointments">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblTodaysAppointments" layoutX="94.0" layoutY="46.0" text="12">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>

                        <AnchorPane prefHeight="100.0" prefWidth="219.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);">
                            <children>
                                <Label layoutX="45.0" layoutY="14.0" text="Pending Payments">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblPendingPayments" layoutX="94.0" layoutY="42.0" text="5">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </children>
                </HBox>

                <!-- Sessions Stats -->
                <HBox layoutX="34.0" layoutY="361.0" prefHeight="100.0" prefWidth="822.0" spacing="80.0">
                    <children>
                        <AnchorPane prefHeight="100.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);">
                            <children>
                                <Label layoutX="57.0" layoutY="14.0" text="Total Sessions">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblTotalSessions" layoutX="78.0" layoutY="46.0" text="356">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>

                        <AnchorPane prefHeight="100.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);">
                            <children>
                                <Label layoutX="38.0" layoutY="14.0" text="Today's New Patients">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblTodaysNewPatients" layoutX="94.0" layoutY="45.0" text="3">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>

                        <AnchorPane prefHeight="100.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);">
                            <children>
                                <Label layoutX="40.0" layoutY="14.0" text="Available Therapists">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblAvailableTherapists" layoutX="94.0" layoutY="42.0" text="8">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </children>
                </HBox>

                <!-- Footer -->
                <HBox alignment="CENTER" layoutY="578.0" prefHeight="72.0" prefWidth="887.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                    <children>
                        <Label text="© 2025 Therapy Management System" />
                    </children>
                </HBox>
            </children>
        </AnchorPane>

        <!-- Top Bar -->
        <HBox alignment="CENTER_RIGHT" layoutX="266.0" prefHeight="60.0" prefWidth="887.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <children>
                <Label fx:id="lblCurrentDate" text="April 5, 2025">
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="lblReceptionistName" text="Receptionist Name">
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </children>
</AnchorPane>
