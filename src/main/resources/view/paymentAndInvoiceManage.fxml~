                        </Button>

                        <Button fx:id="btnGenerateInvoice" mnemonicParsing="false" onAction="#btnGenerateInvoiceOnAction" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #27ae60; -fx-background-radius: 5;" text="Generate Invoice" textFill="WHITE">
