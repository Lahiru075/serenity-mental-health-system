                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>

                        <Label text="Current Status:" textFill="#2c3e50" GridPane.columnIndex="2" GridPane.rowIndex="3">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblCurrentStatus" GridPane.columnIndex="3" GridPane.rowIndex="3">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>

                        <!-- Row 5 -->
                        <Label text="Amount:" textFill="#2c3e50" GridPane.rowIndex="4">
                            <font>
                                <Font name="System Bold" size="14.0" />
