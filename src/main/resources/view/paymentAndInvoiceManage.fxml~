                </GridPane>

                <!-- Status Selection -->
                <HBox alignment="CENTER_LEFT" layoutX="29.0" layoutY="233.0" spacing="48.0">
                    <children>
                        <Label text="Payment Status:" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbStatus" prefHeight="26.0" prefWidth="222.0" />
                    </children>
                </HBox>

                <!-- Action Buttons -->
                <HBox layoutX="30.0" layoutY="273.0" spacing="20.0">
                    <children>
                        <Button fx:id="btnSave" mnemonicParsing="false" onAction="#btnSaveOnAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 5;" text="Save" textFill="WHITE">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #3498db; -fx-background-radius: 5;" text="Update" textFill="WHITE">
