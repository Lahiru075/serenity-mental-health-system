                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <!-- Row 1 -->
                        <Label text="Payment ID:" textFill="#2c3e50" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblPaymentId" prefHeight="31.0" prefWidth="96.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>

                        <Label text="Date:" textFill="#2c3e50" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblDate" prefHeight="37.0" prefWidth="151.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>

                        <!-- Row 2 -->
                        <Label text="Patient ID:" textFill="#2c3e50" GridPane.rowIndex="1">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbPatientId" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

